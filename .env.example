# =============================================
# MovPrimate — Variables de entorno de ejemplo
# Copiar este archivo a .env y ajustar valores
# =============================================

# ----- MongoDB -----
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=changeme
MONGO_HOST=mongo
MONGO_PORT=27017

# ----- Bases de datos por servicio -----
ALUMNOS_DB=movprimate_alumnos
AGENDA_DB=movprimate_agenda
API_DB=movprimate_api
NOTIFICACIONES_DB=movprimate_notificaciones

# ----- URLs inter-servicio -----
ALUMNOS_SERVICE_URL=http://mov-primate-ms-alumnos:3001
AGENDA_SERVICE_URL=http://mov-primate-ms-agenda:3002
API_SERVICE_URL=http://mov-primate-api:3003
NOTIFICACIONES_SERVICE_URL=http://mov-primate-ms-notificaciones:3004
BFF_SERVICE_URL=http://mov-primate-bff:3000

# ----- Puertos externos -----
APP_PORT=4200
BFF_PORT=3000
API_PORT=3003
ALUMNOS_PORT=3001
AGENDA_PORT=3002
NOTIFICACIONES_PORT=3004
MONGO_EXPRESS_PORT=8081

# ----- Reglas de negocio -----
CLASS_CAPACITY_MAX=4
CANCELLATION_WINDOW_MINUTES=60

# ----- RBAC -----
ROLES_ALLOWED=usuario,alumno,admin,superadmin
INITIAL_USER_ROLE=usuario

# ----- Correo / Notificaciones -----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@movprimate.com
MAIL_PASS=changeme
MAIL_FROM=MovPrimate <noreply@movprimate.com>
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BACKOFF_MS=1000

# ----- Mongo Express -----
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=changeme
